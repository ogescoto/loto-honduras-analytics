---
import NumberBalls from "./NumberBalls.astro";
import type { GamePattern } from "@loto/shared-types";

interface Props {
  pattern: GamePattern;
  highlight?: boolean;
}
const { pattern, highlight = false } = Astro.props;

const PATTERN_LABELS: Record<string, string> = {
  frio_caliente:      "Fríos y calientes",
  numerologia_suenos: "Numerología de sueños",
  par_impar:          "Par / impar",
  rachas_inversas:    "Rachas inversas",
};

const meta = pattern.metadata as Record<string, unknown>;
const windowDays = typeof meta?.windowDays === "number" ? meta.windowDays : null;
const parityData = pattern.patternType === "par_impar"
  ? (meta as { even?: number; odd?: number; total?: number })
  : null;

// hot/cold separados para frio_caliente
type NumEntry = { number: number; count: number };
const hotEntries: NumEntry[] = Array.isArray(meta?.hot) ? (meta.hot as NumEntry[]) : [];
const coldEntries: NumEntry[] = Array.isArray(meta?.cold) ? (meta.cold as NumEntry[]) : [];
---

<div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-2">
    <h3 class="font-semibold text-slate-800">
      {PATTERN_LABELS[pattern.patternType] ?? pattern.patternType}
    </h3>
    {windowDays && (
      <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">
        {windowDays}d
      </span>
    )}
  </div>

  {pattern.patternType === "par_impar" && parityData ? (
    <div class="space-y-1">
      <div class="flex items-center justify-between text-sm">
        <span class="text-slate-600">Pares</span>
        <span class="font-medium">{parityData.even ?? 0}</span>
      </div>
      <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
        {(() => {
          const total = (parityData.even ?? 0) + (parityData.odd ?? 0);
          const pct = total > 0 ? Math.round(((parityData.even ?? 0) / total) * 100) : 50;
          return (
            <div class="h-full rounded-full bg-brand" style={`width:${pct}%`} />
          );
        })()}
      </div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-slate-600">Impares</span>
        <span class="font-medium">{parityData.odd ?? 0}</span>
      </div>
    </div>
  ) : pattern.patternType === "frio_caliente" ? (
    <div class="space-y-3">
      {hotEntries.length > 0 && (
        <div>
          <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-orange-500">
            🔥 Calientes
          </p>
          <NumberBalls numbers={hotEntries.map((e) => e.number)} highlight={highlight} />
        </div>
      )}
      {coldEntries.length > 0 && (
        <div>
          <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-sky-500">
            ❄️ Fríos
          </p>
          <NumberBalls numbers={coldEntries.map((e) => e.number)} />
        </div>
      )}
    </div>
  ) : (
    <NumberBalls numbers={pattern.targetNumbers} highlight={highlight} />
  )}
</div>
