---
import Shell from "../layouts/Shell.astro";
---

<Shell title="Recuperar contraseña" active="login">
  <div class="mx-auto max-w-sm">
    <p class="mb-6 text-slate-600">
      Ingresa tu email y te enviaremos un enlace para restablecer tu contraseña.
    </p>

    <form id="forgot-form" class="space-y-4">
      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-slate-700">Correo electrónico</label>
        <input type="email" id="email" name="email" required autocomplete="email" maxlength="254"
          class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          placeholder="tu@email.com" />
      </div>

      <div id="success-msg" class="hidden rounded bg-emerald-50 px-3 py-2 text-sm text-emerald-700"></div>
      <div id="error-msg" class="hidden rounded bg-red-50 px-3 py-2 text-sm text-red-700"></div>

      <button type="submit" id="submit-btn"
        class="flex min-h-[44px] w-full items-center justify-center rounded-lg bg-brand px-4 font-semibold text-white transition hover:bg-brand-dark disabled:opacity-60">
        Enviar enlace de recuperación
      </button>
    </form>

    <p class="mt-4 text-center text-sm text-slate-500">
      <a href="/login" class="font-medium text-brand hover:underline">Volver al inicio de sesión</a>
    </p>
  </div>
</Shell>

<script>
  const form = document.getElementById("forgot-form") as HTMLFormElement;
  const successDiv = document.getElementById("success-msg") as HTMLDivElement;
  const errorDiv = document.getElementById("error-msg") as HTMLDivElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const emailInput = form.elements.namedItem("email") as HTMLInputElement;
  const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showFieldError(input: HTMLInputElement, msg: string) {
    input.classList.add("border-red-400");
    input.classList.remove("border-slate-200");
    let hint = input.nextElementSibling as HTMLElement | null;
    if (!hint || !hint.classList.contains("field-hint")) {
      hint = document.createElement("p");
      hint.className = "field-hint mt-1 text-xs text-red-600";
      input.insertAdjacentElement("afterend", hint);
    }
    hint.textContent = msg;
  }

  function clearFieldError(input: HTMLInputElement) {
    input.classList.remove("border-red-400");
    input.classList.add("border-slate-200");
    const hint = input.nextElementSibling as HTMLElement | null;
    if (hint?.classList.contains("field-hint")) hint.textContent = "";
  }

  emailInput.addEventListener("input", () => {
    const v = emailInput.value;
    if (!v) { clearFieldError(emailInput); return; }
    if (v.length > 254) showFieldError(emailInput, "El email no puede superar 254 caracteres.");
    else if (v.includes("@") && !EMAIL_RE.test(v)) showFieldError(emailInput, "Formato de email inválido.");
    else clearFieldError(emailInput);
  });

  emailInput.addEventListener("paste", (e) => {
    const pasted = e.clipboardData?.getData("text") ?? "";
    if (pasted.length > 254) { e.preventDefault(); showFieldError(emailInput, "El email no puede superar 254 caracteres."); }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    successDiv.classList.add("hidden");
    errorDiv.classList.add("hidden");

    const email = emailInput.value.trim();
    if (!email || !EMAIL_RE.test(email) || email.length > 254) {
      showFieldError(emailInput, "Ingresa un email válido.");
      emailInput.focus();
      return;
    }

    btn.disabled = true;
    btn.textContent = "Enviando…";

    try {
      const res = await fetch(`${apiBase}/api/v1/auth/forgot-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const data = await res.json() as { success: boolean; data?: { message: string }; error?: { message: string } };
      if (data.success) {
        successDiv.textContent = data.data?.message ?? "Si el email existe, recibirás un enlace en breve.";
        successDiv.classList.remove("hidden");
        form.reset();
        clearFieldError(emailInput);
      } else {
        errorDiv.textContent = data.error?.message ?? "Error al procesar la solicitud.";
        errorDiv.classList.remove("hidden");
      }
    } catch {
      errorDiv.textContent = "No se pudo contactar el servidor.";
      errorDiv.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Enviar enlace de recuperación";
    }
  });
</script>
