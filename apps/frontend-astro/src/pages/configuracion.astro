---
/**
 * Configuración de patrones (admin/clerk).
 * Muestra los patrones actuales, un manual y el JSON de configuración
 * interpretable y testeable. Permite validar y PROBAR configuraciones nuevas
 * (combinaciones) contra el histórico, y descargar el JSON.
 */
import Shell from "../layouts/Shell.astro";
import { getToken, getValidPayload } from "../lib/auth.ts";
import { apiGetSSR } from "../lib/api.ts";

const payload = getValidPayload(Astro.cookies);
const token = getToken(Astro.cookies);

if (!payload || (payload.role !== "admin" && payload.role !== "clerk")) {
  return Astro.redirect("/login");
}

let configJson: unknown = null;
let errMsg: string | null = null;
const res = await apiGetSSR<unknown>("/api/v1/features/config", Astro.locals);
if (res.success) configJson = res.data;
else errMsg = res.error.message;

const GAMES = [
  "diaria_11am","diaria_3pm","diaria_9pm","pega3_11am","pega3_3pm","pega3_9pm",
  "premia2_11am","premia2_3pm","premia2_9pm","juga3_11am","juga3_3pm","juga3_9pm",
  "super_premio",
];
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<Shell title="Configuración de patrones" active="admin">
  <nav class="nav-pills mb-6 flex gap-2 text-sm">
    <a href="/admin" class="shrink-0 rounded-lg border border-slate-200 px-3 py-1.5 text-slate-600 hover:bg-slate-50">Admin</a>
    <a href="/admin/resultados" class="shrink-0 rounded-lg border border-slate-200 px-3 py-1.5 text-slate-600 hover:bg-slate-50">Resultados</a>
    <a href="/admin/fuentes" class="shrink-0 rounded-lg border border-slate-200 px-3 py-1.5 text-slate-600 hover:bg-slate-50">Fuentes</a>
    <a href="/admin/logs" class="shrink-0 rounded-lg border border-slate-200 px-3 py-1.5 text-slate-600 hover:bg-slate-50">Logs</a>
    <a href="/configuracion" class="shrink-0 rounded-lg bg-brand px-3 py-1.5 font-semibold text-white">Patrones</a>
  </nav>

  {errMsg && <p class="mb-4 rounded bg-red-50 p-3 text-sm text-red-700">{errMsg}</p>}

  {configJson && (
    <div id="cfg" class="space-y-6">
      <!-- Prueba rápida -->
      <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="mb-1 font-semibold text-slate-800">Probar una configuración nueva</h2>
        <p class="mb-3 text-xs text-slate-500">
          Edita el JSON abajo (añade/edita patrones en <code class="rounded bg-slate-100 px-1">patterns</code>,
          o las combinaciones en <code class="rounded bg-slate-100 px-1">combos</code>), valídalo y evalúa contra el histórico.
        </p>
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <label class="text-sm font-medium text-slate-700" for="cmp-game">Juego:</label>
          <select id="cmp-game" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
            {GAMES.map((g) => <option value={g} selected={g === "diaria_11am"}>{g}</option>)}
          </select>
          <label class="text-sm font-medium text-slate-700" for="cmp-days">Días:</label>
          <select id="cmp-days" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
            {[7, 15, 30, 60, 90].map((d) => <option value={d}>{d}</option>)}
          </select>
          <button id="btn-validate" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" type="button">Validar JSON</button>
          <button id="btn-test" class="rounded-lg bg-brand px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-dark" type="button">Probar (evaluar combos)</button>
          <button id="btn-download" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50" type="button">Descargar JSON</button>
        </div>
        <textarea id="editor" spellcheck="false"
          class="h-64 w-full rounded-lg border border-slate-200 bg-slate-50 p-3 font-mono text-xs shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"></textarea>
        <p id="test-status" class="mt-2 text-xs"></p>
      </div>

      <!-- Patrones actuales -->
      <div>
        <h2 class="mb-1 text-lg font-bold text-slate-800">Patrones actuales</h2>
        <p class="mb-1 text-xs text-slate-500">
          Cada patrón analiza una <strong>secuencia de sorteos en conjunto</strong>, no una hora aislada.
          <span class="rounded-full bg-teal-100 px-1.5 py-0.5 text-[10px] font-medium text-teal-700">Familia</span> analiza
          toda la serie del tipo de juego (varias jornadas/horas y días seguidos);
          <span class="rounded-full bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-700">Juego</span> se
          calcula contra la jornada/hora concreta. Toca una tarjeta para ver "cómo está hecho".
        </p>
        <p id="summary" class="mb-3 text-xs text-slate-400"></p>
        <div id="pattern-list" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Se rellena con JS -->
        </div>
      </div>
    </div>
  )}
</Shell>

<script define:vars={{ apiBase }}>
  const cfg = document.getElementById("cfg");
  if (!cfg) return;
  const editor = document.getElementById("editor");
  const testStatus = document.getElementById("test-status");
  const btnValidate = document.getElementById("btn-validate");
  const btnTest = document.getElementById("btn-test");
  const btnDownload = document.getElementById("btn-download");
  const gameSel = document.getElementById("cmp-game");
  const daysSel = document.getElementById("cmp-days");
  const token = document.cookie.split("; ").find((c) => c.startsWith("loto_token="))?.split("=")[1];

  const headers = (json = false) => {
    const h = {};
    if (json) h["Content-Type"] = "application/json";
    if (token) h["Authorization"] = `Bearer ${token}`;
    return h;
  };

  const fmt = (n) => String(n).padStart(2, "0");
  const HN_TZ = "America/Tegucigalpa";
  const civilDate = (iso) => { const p = iso.substring(0, 10); return new Date(p + "T12:00:00Z"); };

  function tstatus(msg, ok = true) {
    testStatus.textContent = msg;
    testStatus.className = "mt-2 text-xs " + (ok ? "text-emerald-700" : "text-red-600");
  }

  // Cargar config del servidor
  fetch(`${apiBase}/api/v1/features/config`, { headers: headers() })
    .then((r) => r.json())
    .then((d) => {
      if (!d.success) return;
      const config = d.data;
      if (editor) editor.value = JSON.stringify(config, null, 2);
      renderPatterns(config.patterns || []);
      const blocks = config.blocks || {};
      const summary = document.getElementById("summary");
      if (summary) {
        const n = (config.patterns || []).length;
        const bl = Object.keys(blocks).length;
        summary.textContent = `${n} patrones en ${bl} bloques. Edita el JSON para añadir/ajustar configuraciones y pruébalas.`;
      }
    });

  function renderPatterns(patterns) {
    const list = document.getElementById("pattern-list");
    list.innerHTML = "";
    for (const p of patterns) {
      const card = document.createElement("div");
      card.className = "rounded-lg border border-slate-200 bg-white p-3 text-xs shadow-sm cursor-pointer transition hover:border-brand";
      const scopeLabel = p.scope === "juego"
        ? '<span class="rounded-full bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium text-amber-700">Juego · una hora</span>'
        : '<span class="rounded-full bg-teal-100 px-1.5 py-0.5 text-[10px] font-medium text-teal-700">Familia · secuencia completa</span>';
      const block = p.block ? `<span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-500">bloque ${p.block}</span>` : "";
      card.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="font-semibold text-slate-800">${p.label}</div>
            <code class="font-mono text-[10px] text-slate-400">${p.code}</code>
          </div>
          <span class="flex shrink-0 items-center gap-1">${scopeLabel} ${block}</span>
        </div>
        <p class="mt-1 text-slate-500">${p.description}</p>
        <details class="mt-1">
          <summary class="cursor-pointer text-[11px] font-medium text-brand hover:underline">Cómo está hecho</summary>
          <div class="mt-1 space-y-1 rounded bg-slate-50 p-2 text-[11px] text-slate-600">
            <div><span class="font-medium text-slate-700">Alcance:</span> ${p.scope === "juego" ? "solo la jornada/hora de ese juego" : "toda la secuencia de sorteos de la familia (varias jornadas y días seguidos)"}</div>
            <div><span class="font-medium text-slate-700">Clasificación:</span> ${p.category || "—"} ${p.category && p.category !== "none" ? "(no puede combinarse con otro de esta misma clasificación)" : ""}</div>
            <div><span class="font-medium text-slate-700">Ventana:</span> ${p.windowDesc || "—"}</div>
            <div><span class="font-medium text-slate-700">Regla:</span> ${p.description}</div>
          </div>
        </details>
      `;
      list.appendChild(card);
    }
  }

  function parseEditor() {
    try { return JSON.parse(editor.value); }
    catch { tstatus("JSON inválido: error de sintaxis.", false); return null; }
  }

  btnValidate.addEventListener("click", () => {
    const cfgObj = parseEditor();
    if (!cfgObj) return;
    if (!Array.isArray(cfgObj.patterns)) { tstatus("falta 'patterns[]'.", false); return; }
    const bad = cfgObj.patterns.filter((p) => !p.code || !p.label);
    if (bad.length) { tstatus(`${bad.length} patrones sin code/label.`, false); return; }
    tstatus(`JSON válido: ${cfgObj.patterns.length} patrones.`);
  });

  btnDownload.addEventListener("click", () => {
    const blob = new Blob([editor.value], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "patrones.config.json";
    a.click();
    URL.revokeObjectURL(a.href);
  });

  btnTest.addEventListener("click", async () => {
    const cfgObj = parseEditor();
    if (!cfgObj) return;
    const patterns = cfgObj.patterns || [];
    // Las combinaciones del JSON: combos[] o, si no hay, cada patrón como combo individual.
    let combos = [];
    if (Array.isArray(cfgObj.combos) && cfgObj.combos.length) {
      combos = cfgObj.combos;
    } else {
      // prueba funcional: cada patrón como combinación de 1.
      combos = patterns.map((p) => ({ name: p.label, features: [p.code] }));
    }
    if (!combos.length) { tstatus("Sin combinaciones que probar.", false); return; }

    btnTest.disabled = true;
    btnTest.textContent = "Probando…";
    const days = Number(daysSel.value || 30);
    const game = gameSel.value;
    const rows = [];
    for (const combo of combos) {
      if (!Array.isArray(combo.features) || combo.features.length === 0) continue;
      const res = await fetch(`${apiBase}/api/v1/features/${game}/hits`, {
        method: "POST", headers: headers(true),
        body: JSON.stringify({ features: combo.features, days }),
      }).then((r) => r.json());
      if (res.success) {
        const d = res.data;
        const rate = d.evaluatedDraws > 0 ? Math.round((d.totalHits / d.evaluatedDraws) * 100) : 0;
        rows.push({ name: combo.name || combo.features.join("+"), rate, hits: d.totalHits, eval: d.evaluatedDraws, last: d.hits?.[0] });
      }
    }
    renderTable(rows, days, game);
    btnTest.disabled = false;
    btnTest.textContent = "Probar (evaluar combos)";
  });

  function renderTable(rows, days, game) {
    let html = `<div class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm"><table class="w-full text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-3 py-2 text-left">Combinación</th><th class="px-3 py-2 text-left">Aciertos</th><th class="px-3 py-2 text-left">Efectividad</th><th class="px-3 py-2 text-left">Último</th></tr></thead><tbody>`;
    for (const r of rows) {
      const lc = r.rate >= 50 ? "bg-emerald-100 text-emerald-700" : r.rate >= 20 ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-600";
      const last = r.last ? civilDate(r.last.drawDate).toLocaleDateString("es-HN", { timeZone: HN_TZ, day: "2-digit", month: "short", year: "numeric" }) : "—";
      html += `<tr><td class="px-3 py-2 font-medium text-slate-800">${r.name}</td><td class="px-3 py-2 text-slate-700">${r.hits}/${r.eval}</td><td class="px-3 py-2"><span class="rounded-full px-2 py-0.5 text-xs font-semibold ${lc}">${r.rate}%</span></td><td class="px-3 py-2 text-xs text-slate-500">${last}</td></tr>`;
    }
    html += `</tbody></table></div><p class="mt-1 text-xs text-slate-400">Combinaciones probadas en ${game} · últimos ${days} días.</p>`;
    testStatus.insertAdjacentHTML("afterend", html);
    const old = testStatus.querySelector("div");
  }
</script>