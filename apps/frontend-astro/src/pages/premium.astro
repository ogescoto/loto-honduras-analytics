---
import Shell from "../layouts/Shell.astro";
import MetaPatternCard from "../components/MetaPatternCard.astro";
import { apiGetSSR } from "../lib/api.ts";
import { getToken, getValidPayload } from "../lib/auth.ts";
import type { MetaPattern } from "@loto/shared-types";

const payload = getValidPayload(Astro.cookies);
const token = getToken(Astro.cookies);
const checkout = Astro.url.searchParams.get("checkout");

let metaPatterns: MetaPattern[] = [];
let hasSubscription = false;
let errorMsg: string | null = null;

if (token && payload) {
  const res = await apiGetSSR<{ metaPatterns: MetaPattern[] }>(
    "/api/v1/premium/meta-patterns",
    Astro.locals,
    token,
  );
  if (res.success) {
    metaPatterns = res.data.metaPatterns;
    hasSubscription = true;
  } else if (res.error.code === "SUBSCRIPTION_REQUIRED" || res.error.code === "FORBIDDEN") {
    hasSubscription = false;
  } else {
    errorMsg = res.error.message;
  }
}

const GAMES = [
  { value: "pega3_9pm",   label: "Pega 3 · 9 PM" },
  { value: "pega3_3pm",   label: "Pega 3 · 3 PM" },
  { value: "pega3_11am",  label: "Pega 3 · 11 AM" },
  { value: "premia2_9pm", label: "Premia 2 · 9 PM" },
  { value: "premia2_3pm", label: "Premia 2 · 3 PM" },
  { value: "premia2_11am",label: "Premia 2 · 11 AM" },
  { value: "juga3_9pm",   label: "Jugá 3 · 9 PM" },
  { value: "juga3_3pm",   label: "Jugá 3 · 3 PM" },
  { value: "juga3_11am",  label: "Jugá 3 · 11 AM" },
  { value: "diaria_9pm",  label: "La Diaria · 9 PM" },
  { value: "diaria_3pm",  label: "La Diaria · 3 PM" },
  { value: "diaria_11am", label: "La Diaria · 11 AM" },
  { value: "super_premio",label: "Super Premio" },
];
---

<Shell
  title="Estudio Premium"
  active="premium"
  ogTitle="Estudio Premium — combina patrones"
  ogDescription="Combina patrones, evalúa tu efectividad histórica, ve candidatos para el próximo sorteo y emula por ventana."
  isPremium={hasSubscription}
>
  {checkout === "success" && (
    <p class="mb-4 rounded bg-emerald-50 p-3 text-sm text-emerald-800">
      ¡Pago recibido! Tu acceso premium se activará en unos segundos. Recarga la página si no ves el estudio.
    </p>
  )}

  {errorMsg && (
    <p class="mb-4 rounded bg-amber-50 p-3 text-sm text-amber-800">{errorMsg}</p>
  )}

  {!token && (
    <div>
      <div class="rounded-lg border border-brand/30 bg-white p-6 text-center">
        <p class="mb-2 text-slate-700 font-semibold">Acceso exclusivo para suscriptores</p>
        <p class="mb-5 text-sm text-slate-500">Combina hasta 7 patrones, mide qué tan acertada es tu combinación y obtén candidatos para el próximo sorteo.</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a href="/login" class="flex min-h-[44px] items-center justify-center rounded-lg bg-brand px-6 font-semibold text-white hover:bg-brand-dark">
            Iniciar sesión
          </a>
          <a href="#planes" class="flex min-h-[44px] items-center justify-center rounded-lg border border-brand px-6 font-semibold text-brand hover:bg-brand/5">
            Ver planes
          </a>
        </div>
      </div>

      <!-- Planes visibles también sin sesión -->
      <div id="planes" class="mt-6 rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-bold">Planes de suscripción</h2>
        <div class="mb-5 grid gap-3 sm:grid-cols-2">
          {[
            { months: 1, label: "1 mes", price: "USD 5.00" },
            { months: 3, label: "3 meses", price: "USD 13.00" },
            { months: 6, label: "6 meses", price: "USD 24.00" },
            { months: 12, label: "12 meses", price: "USD 42.00" },
          ].map(({ label, price }) => (
            <a href="/login"
              class="rounded-lg border-2 border-brand/30 p-4 text-left transition hover:border-brand hover:bg-brand/5 focus:outline-none focus:ring-2 focus:ring-brand">
              <p class="font-semibold text-slate-800">{label}</p>
              <p class="text-sm text-slate-500">{price}</p>
            </a>
          ))}
        </div>
        <p class="text-xs text-slate-400 text-center">Inicia sesión para pagar online (Stripe) o en ventanilla.</p>
      </div>
    </div>
  )}

  {token && !hasSubscription && (
    <div>
      <!-- Preview blur del estudio (CTA visual) -->
      <div class="relative mb-6">
        <div class="space-y-3 opacity-80">
          <div class="rounded-lg border border-brand/30 bg-white p-4 shadow-sm blur-sm select-none pointer-events-none">
            <p class="mb-2 text-sm text-slate-700">Combina patrones (Ej: Pareja 100 + Dígitos Gemelos + Caliente…) y mira cuántos sorteos habría acertado y los candidatos para el próximo.</p>
            <div class="flex gap-2">
              {[7, 23, 41].map((n) => (
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand text-white text-xs font-bold shadow-sm">
                  {String(n).padStart(2, "0")}
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="rounded-full bg-brand/90 px-4 py-1.5 text-xs font-bold text-white shadow">
            Solo para suscriptores
          </span>
        </div>
      </div>

      <!-- Planes de suscripción -->
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-bold">Activar Premium</h2>
        <div class="mb-5 grid gap-3 sm:grid-cols-2">
          {[
            { months: 1, label: "1 mes", price: "USD 5.00" },
            { months: 3, label: "3 meses", price: "USD 13.00" },
            { months: 6, label: "6 meses", price: "USD 24.00" },
            { months: 12, label: "12 meses", price: "USD 42.00" },
          ].map(({ months, label, price }) => (
            <button
              data-months={months}
              class="checkout-btn rounded-lg border-2 border-brand/30 p-4 text-left transition hover:border-brand hover:bg-brand/5 focus:outline-none focus:ring-2 focus:ring-brand"
            >
              <p class="font-semibold text-slate-800">{label}</p>
              <p class="text-sm text-slate-500">{price}</p>
            </button>
          ))}
        </div>
        <p class="text-xs text-slate-400 text-center">Pago seguro vía Stripe. Cancela cuando quieras.</p>
      </div>
    </div>
  )}

  {hasSubscription && (
    <div id="estudio" data-game="diaria_11am">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <label class="text-sm font-medium text-slate-700" for="game-select">Juego:</label>
        <select id="game-select" class="rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200">
          {GAMES.map(g => (
            <option value={g.value} selected={g.value === "diaria_11am"}>{g.label}</option>
          ))}
        </select>
        <button id="btn-eval-all" class="ml-auto rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" type="button">
          Evaluar todas mis combinaciones
        </button>
      </div>

      <!-- Constructor -->
      <div class="mb-6 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="mb-1 font-semibold text-slate-800">Construye una combinación</h2>
        <p class="mb-3 text-xs text-slate-500">
          Elige hasta 7 patrones. Guarda la combinación y evalúala: verás su <strong>efectividad histórica</strong> (cuántos sorteos habría acertado), <strong>candidatos para el próximo sorteo</strong> y podrás <strong>emular</strong> por ventana de días.
        </p>

        <div id="feature-catalog" class="mb-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Se rellena con JS -->
        </div>

        <div id="chips-bar" class="mb-4 hidden rounded-lg border border-dashed border-teal-300 bg-teal-50/60 p-3">
          <p class="mb-2 text-xs font-medium text-teal-700">Combinación (arrastra los chips para ordenarla):</p>
          <div id="chips-list" class="flex flex-wrap items-center gap-2"></div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <input id="pattern-name" type="text" placeholder="Nombre (ej: Mi combo estrella)" maxlength="60"
            class="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-200" />
          <button id="btn-save" disabled class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40 hover:bg-slate-700">Guardar combinación</button>
          <button id="btn-eval-sel" disabled class="rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white disabled:opacity-40 hover:bg-brand-dark">Evaluar selección</button>
          <button id="btn-clear" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50" type="button">Limpiar</button>
        </div>
        <p id="status" class="mt-2 text-xs"></p>
      </div>

      <!-- Mis combinaciones -->
      <div class="mb-6">
        <h2 class="mb-2 text-lg font-bold text-slate-800">Mis combinaciones</h2>
        <div id="saved-list" class="flex flex-wrap gap-2">
          <span class="text-sm text-slate-400">Cargando…</span>
        </div>
      </div>

      <!-- Resultados de evaluación -->
      <div id="results" class="space-y-4">
        <!-- La evaluación individual de cada combo se pinta aquí -->
      </div>

      <div id="compare" class="hidden mt-6">
        <h2 class="mb-2 text-lg font-bold text-slate-800">Comparativa (aciertos por combinación)</h2>
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-4 py-3 text-left">Combinación</th>
                <th class="px-4 py-3 text-left">Patrones</th>
                <th class="px-4 py-3 text-left">Aciertos</th>
                <th class="px-4 py-3 text-left">Efectividad</th>
                <th class="px-4 py-3 text-left">Último acierto</th>
              </tr>
            </thead>
            <tbody id="compare-body" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
      </div>

      <!-- Meta-patrones (sección secundaria) -->
      <div class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="mb-2 text-lg font-bold text-slate-800">Meta-patrones psico-estadísticos</h2>
        {metaPatterns.length === 0 ? (
          <p class="text-sm text-slate-500">Aún no hay meta-patrones calculados para este juego.</p>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {metaPatterns.map((m) => <MetaPatternCard pattern={m} />)}
          </div>
        )}
      </div>
    </div>
  )}
</Shell>

<script is:inline>
  // Checkout (solo visible si no hay suscripción)
  const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
  document.querySelectorAll(".checkout-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const months = btn.dataset.months;
      const token = document.cookie.match(/loto_token=([^;]+)/)?.[1];
      if (!token) { window.location.href = "/login"; return; }
      btn.disabled = true;
      btn.textContent = "Redirigiendo…";
      try {
        const res = await fetch(`${apiBase}/api/v1/payments/checkout`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ validityMonths: Number(months) }),
        });
        const data = await res.json();
        if (data.success && data.data?.checkoutUrl) {
          window.location.href = data.data.checkoutUrl;
        } else { btn.disabled = false; btn.textContent = "Error — intenta de nuevo"; }
      } catch { btn.disabled = false; btn.textContent = "Error — intenta de nuevo"; }
    });
  });
</script>

<script>
  // @ts-nocheck
  const estudio = document.getElementById("estudio");
  if (estudio) {
    const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
    const getToken = () => document.cookie.split("; ").find((c) => c.startsWith("loto_token="))?.split("=")[1] ?? "";
    const token = getToken();
    const headers = (json = false) => {
      const h = {};
      if (json) h["Content-Type"] = "application/json";
      if (token) h["Authorization"] = `Bearer ${token}`;
      return h;
    };

    let catalog: { code: string; label: string; description: string }[] = [];
    let combos: { id: string; name: string; game: string; features: string[] }[] = [];
    let selectedFeatures = new Set<string>();
    let currentGame = "diaria_11am";

    const featureCatalog = document.getElementById("feature-catalog") as HTMLElement | null;
    const chipsBar = document.getElementById("chips-bar") as HTMLElement | null;
    const chipsList = document.getElementById("chips-list") as HTMLElement | null;
    const patternName = document.getElementById("pattern-name") as HTMLInputElement | null;
    const btnSave = document.getElementById("btn-save") as HTMLButtonElement | null;
    const btnEvalSel = document.getElementById("btn-eval-sel") as HTMLButtonElement | null;
    const btnClear = document.getElementById("btn-clear") as HTMLButtonElement | null;
    const btnEvalAll = document.getElementById("btn-eval-all") as HTMLButtonElement | null;
    const savedList = document.getElementById("saved-list") as HTMLElement | null;
    const results = document.getElementById("results") as HTMLElement | null;
    const status = document.getElementById("status") as HTMLElement | null;
    const compare = document.getElementById("compare") as HTMLElement | null;
    const compareBody = document.getElementById("compare-body") as HTMLElement | null;
    const gameSelect = document.getElementById("game-select") as HTMLSelectElement | null;
    const guideLabels = {};

    const fmt = (n) => String(n).padStart(2, "0");
    const HN_TZ = "America/Tegucigalpa";
    const civilDate = (iso) => { const p = iso.substring(0, 10); return new Date(p + "T12:00:00Z"); };

    function sstatus(msg, ok = true) {
      if (!status) return;
      status.textContent = msg;
      status.className = "mt-2 text-xs " + (ok ? "text-emerald-700" : "text-red-600");
    }

    function setButtons() {
      const n = selectedFeatures.size;
      btnSave.disabled = n === 0;
      btnEvalSel.disabled = n === 0;
    }

    function renderCatalog() {
      featureCatalog.innerHTML = "";
      for (const feat of catalog) {
        const active = selectedFeatures.has(feat.code);
        const b = document.createElement("button");
        b.type = "button";
        b.className = "text-left rounded-lg border p-2.5 text-xs transition select-none " +
          (active ? "border-brand bg-brand/5 ring-2 ring-brand/40" : "border-slate-200 bg-white hover:border-brand/50");
        b.innerHTML = `<div class="font-semibold ${active ? "text-brand" : "text-slate-800"}"></div><div class="text-slate-500 leading-relaxed"></div>`;
        b.querySelector("div").textContent = feat.label;
        b.querySelectorAll("div")[1].textContent = feat.description;
        b.addEventListener("click", () => {
          if (selectedFeatures.has(feat.code)) selectedFeatures.delete(feat.code);
          else if (selectedFeatures.size < 7) selectedFeatures.add(feat.code);
          renderCatalog(); renderChips(); setButtons();
        });
        featureCatalog.appendChild(b);
      }
    }

    function renderChips() {
      chipsBar.classList.toggle("hidden", selectedFeatures.size === 0);
      chipsList.innerHTML = "";
      const labels = new Map(catalog.map((f) => [f.code, f.label]));
      selectedFeatures.forEach((code, i) => {
        const chip = document.createElement("span");
        chip.draggable = true;
        chip.dataset.code = code;
        chip.className = "flex cursor-grab items-center gap-1.5 rounded-full bg-brand px-3 py-1 text-xs font-medium text-white active:cursor-grabbing";
        const lbl = document.createElement("span");
        lbl.textContent = `${i + 1}. ${labels.get(code) ?? code}`;
        const x = document.createElement("button");
        x.type = "button"; x.textContent = "✕";
        x.className = "opacity-70 hover:opacity-100";
        x.addEventListener("click", () => { selectedFeatures.delete(code); renderCatalog(); renderChips(); setButtons(); });
        chip.appendChild(lbl); chip.appendChild(x);
        chip.addEventListener("dragstart", (e) => { e.dataTransfer.setData("text/plain", code); chip.classList.add("opacity-50"); });
        chip.addEventListener("dragend", () => chip.classList.remove("opacity-50"));
        chipsList.appendChild(chip);
      });
      chipsList.addEventListener("dragover", (e) => {
        e.preventDefault();
        const over = e.target.closest("span.chip");
        const dragging = chipsList.querySelector("span.chip.opacity-50");
        if (!over || !dragging || over === dragging) return;
        const after = e.clientX > over.getBoundingClientRect().left + over.getBoundingClientRect().width / 2;
        if (after) over.after(dragging); else over.before(dragging);
      });
      chipsList.addEventListener("drop", (e) => {
        e.preventDefault();
        selectedFeatures.clear();
        chipsList.querySelectorAll("span.chip").forEach((c) => selectedFeatures.add(c.dataset.code));
      });
    }

    async function saveCombo() {
      if (selectedFeatures.size === 0) return;
      const name = patternName.value.trim();
      if (name.length < 2 || name.length > 60) { sstatus("Pon un nombre (2-60 caracteres).", false); return; }
      const res = await fetch(`${API_BASE}/api/v1/saved-patterns`, {
        method: "POST", headers: headers(true),
        body: JSON.stringify({ name, game: currentGame, features: [...selectedFeatures] }),
      });
      const data = await res.json();
      if (data.success) { patternName.value = ""; sstatus(`Guardada: ${name}`); loadCombos(); }
      else sstatus(data.error?.message ?? "Error al guardar.", false);
    }

    async function loadCombos() {
      const res = await fetch(`${API_BASE}/api/v1/saved-patterns`, { headers: headers() });
      const data = await res.json();
      combos = data.success ? data.data : [];
      renderCombos();
    }

    function renderCombos() {
      if (combos.length === 0) { savedList.innerHTML = '<span class="text-sm text-slate-400">Aún no tienes combinaciones. Crea y guarda una arriba.</span>'; return; }
      savedList.innerHTML = "";
      const labels = new Map(catalog.map((f) => [f.code, f.label]));
      for (const p of combos) {
        const pill = document.createElement("span");
        pill.className = "flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs shadow-sm";
        const nameBtn = document.createElement("button");
        nameBtn.type = "button";
        nameBtn.className = "font-semibold text-slate-800 hover:text-brand";
        nameBtn.textContent = p.name;
        nameBtn.title = p.features.map((f) => labels.get(f) ?? f).join(" + ");
        nameBtn.addEventListener("click", () => { selectCombo(p); loadCombos(); });
        const evalBtn = document.createElement("button");
        evalBtn.type = "button";
        evalBtn.className = "rounded bg-brand/10 px-2 py-1 font-medium text-brand hover:bg-brand/20";
        evalBtn.textContent = "Evaluar";
        evalBtn.addEventListener("click", () => evalCombo(p));
        const delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "text-slate-400 hover:text-red-600";
        delBtn.textContent = "✕";
        delBtn.setAttribute("aria-label", "Eliminar " + p.name);
        delBtn.addEventListener("click", async () => {
          await fetch(`${API_BASE}/api/v1/saved-patterns/${p.id}`, { method: "DELETE", headers: headers() });
          loadCombos();
        });
        pill.appendChild(nameBtn); pill.appendChild(evalBtn); pill.appendChild(delBtn);
        savedList.appendChild(pill);
      }
    }

    function selectCombo(p) {
      selectedFeatures.clear();
      p.features.forEach((f) => selectedFeatures.add(f));
      patternName.value = p.name;
      renderCatalog(); renderChips(); setButtons();
      sstatus(`Seleccionada: ${p.name} — evalúala o edítala y vuelve a guardar.`);
    }

    // ── Evaluación ──────────────────────────────────────────────────────────
    async function evalCombo(p, days = 30) {
      const card = document.createElement("div");
      card.className = "rounded-lg border border-slate-200 bg-white p-4 shadow-sm";
      card.innerHTML = `<div class="flex flex-wrap items-center gap-2"><span class="font-semibold text-slate-800">${p.name}</span><span class="text-xs text-slate-400">${p.game}</span><span class="ml-auto text-xs text-slate-400">evaluando…</span></div>`;
      results.insertBefore(card, results.firstChild);

      const [h, f] = await Promise.all([
        fetch(`${API_BASE}/api/v1/features/${p.game}/hits`, { method: "POST", headers: headers(true), body: JSON.stringify({ features: p.features, days }) }).then((r) => r.json()),
        fetch(`${API_BASE}/api/v1/features/${p.game}/filter`, { method: "POST", headers: headers(true), body: JSON.stringify({ features: p.features }) }).then((r) => r.json()),
      ]);

      const data = h.data || {};
      const hitRate = data.evaluatedDraws > 0 ? Math.round((data.totalHits / data.evaluatedDraws) * 100) : 0;
      const labels = new Map(catalog.map((x) => [x.code, x.label]));

      // Ventana de emulación
      const windowSel = `
        <label class="text-xs text-slate-500">Emular últimos</label>
        <select class="days-sel rounded border border-slate-300 px-2 py-1 text-xs">
          ${[7, 15, 30, 60, 90].map((d) => `<option value="${d}" ${d === days ? "selected" : ""}>${d} días</option>`).join("")}
        </select>`;

      card.innerHTML = `
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span class="font-semibold text-slate-800">${p.name}</span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">${p.game}</span>
          <span class="rounded-full px-2 py-0.5 text-xs font-semibold ${hitRate >= 50 ? "bg-emerald-100 text-emerald-700" : hitRate >= 20 ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-600"}">${hitRate}% efectividad</span>
          <span class="text-xs text-slate-400">${data.totalHits}/${data.evaluatedDraws} sorteos acertados</span>
          <span class="ml-auto flex items-center gap-1">${windowSel}</span>
        </div>
        <p class="mb-2 text-xs text-slate-500">${p.features.map((f) => labels.get(f) ?? f).join(" · ")}</p>

        ${f.success && f.data?.exact?.length ? `<div class="mb-3"><span class="mr-2 text-xs font-medium text-slate-600">Candidatos próximos:</span>${f.data.exact.map((n) => `<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand font-mono text-xs font-bold text-white">${fmt(n)}</span>`).join("")}</div>` : ""}
        ${f.success && !f.data?.exact?.length && f.data?.partial?.length ? `<div class="mb-3 text-xs text-amber-600">Sin coincidencia exacta; los más cercanos (${f.data.matchCount}/${f.data.totalRequested}): ${f.data.partial.map((n) => `<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-500 font-mono text-xs font-bold text-white">${fmt(n)}</span>`).join("")}</div>` : ""}

        <details class="mt-1">
          <summary class="cursor-pointer text-xs font-medium text-brand hover:underline">Ver historial de aciertos (últimos años)</summary>
          <div class="mt-2 space-y-1.5">${data.hits && data.hits.length ? data.hits.slice(0, 12).map((hh) => { const d0 = civilDate(hh.drawDate); const fecha = d0.toLocaleDateString("es-HN", { timeZone: HN_TZ, day: "2-digit", month: "short", year: "numeric" }); const diff = Math.max(0, Math.floor((Date.now() - Date.UTC(d0.getUTCFullYear(), d0.getUTCMonth(), d0.getUTCDate(), 4, 0, 0)) / 86400000)); return `<div class="flex items-center gap-2 text-xs"><span class="text-slate-600">${fecha}</span><span class="text-teal-700">hace ~${diff} días</span><span class="font-mono text-slate-500">#${hh.matchedNumbers.map((n) => fmt(n)).join(" #")}</span></div>`; }).join("") : `<div class="text-xs text-slate-400">Sin aciertos en esta ventana.</div>`}</div>
        </details>
      `;

      card.querySelector(".days-sel").addEventListener("change", (e) => {
        card.remove();
        evalCombo(p, Number(e.target.value));
      });
      return { p, hitRate, totalHits: data.totalHits, evaluatedDraws: data.evaluatedDraws, hits: data.hits || [] };
    }

    async function evalAll() {
      if (combos.length === 0) { sstatus("Guarda al menos una combinación para comparar.", false); return; }
      btnEvalAll.disabled = true;
      btnEvalAll.textContent = "Evaluando…";
      const rows = [];
      for (const p of combos) {
        const [h] = await evalCombo(p, 90);
        rows.push(h);
      }
      // Completar tabla comparativa
      compare.classList.remove("hidden");
      compareBody.innerHTML = "";
      const labels = new Map(catalog.map((x) => [x.code, x.label]));
      rows.sort((a, b) => b.hitRate - a.hitRate);
      for (const r of rows) {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-slate-50";
        const last = r.hits && r.hits[0] ? civilDate(r.hits[0].drawDate).toLocaleDateString("es-HN", { timeZone: HN_TZ, day: "2-digit", month: "short", year: "numeric" }) : "—";
        tr.innerHTML = `<td class="px-4 py-3 font-medium text-slate-800">${r.p.name}</td>
          <td class="px-4 py-3 text-xs text-slate-500">${r.p.features.length} patrones</td>
          <td class="px-4 py-3 text-slate-700">${r.totalHits}/${r.evaluatedDraws}</td>
          <td class="px-4 py-3"><span class="rounded-full px-2 py-0.5 text-xs font-semibold ${r.hitRate >= 50 ? "bg-emerald-100 text-emerald-700" : r.hitRate >= 20 ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-600"}">${r.hitRate}%</span></td>
          <td class="px-4 py-3 text-xs text-slate-500">${last}</td>`;
        compareBody.appendChild(tr);
      }
      btnEvalAll.disabled = false;
      btnEvalAll.textContent = "Evaluar todas mis combinaciones";
    }

    // ── eventos ──
    gameSelect?.addEventListener("change", () => { currentGame = gameSelect.value; });
    btnSave?.addEventListener("click", saveCombo);
    btnEvalSel?.addEventListener("click", () => {
      if (selectedFeatures.size === 0) return;
      evalCombo({ name: patternName?.value.trim() || "Selección actual", game: currentGame, features: [...selectedFeatures] });
    });
    btnClear?.addEventListener("click", () => { selectedFeatures.clear(); renderCatalog(); renderChips(); setButtons(); sstatus(""); });
    btnEvalAll?.addEventListener("click", evalAll);

    // ── inicio ──
    (async () => {
      const cat = await fetch(`${API_BASE}/api/v1/features/catalog`, { headers: headers() }).then((r) => r.json());
      if (cat.success) catalog = cat.data;
      renderCatalog();
      renderChips();
      setButtons();
      await loadCombos();
    })();
  }
</script>