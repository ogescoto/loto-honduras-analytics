---
import Shell from "../layouts/Shell.astro";

const token = Astro.url.searchParams.get("token");
if (!token) return Astro.redirect("/forgot-password");
---

<Shell title="Nueva contraseña" active="login">
  <div class="mx-auto max-w-sm">
    <p class="mb-6 text-slate-600">Elige una nueva contraseña para tu cuenta.</p>

    <form id="reset-form" class="space-y-4">
      <input type="hidden" id="token" value={token} />
      <div>
        <label for="password" class="mb-1 block text-sm font-medium text-slate-700">Nueva contraseña</label>
        <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8"
          class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          placeholder="Mínimo 8 caracteres" />
      </div>
      <div>
        <label for="confirm" class="mb-1 block text-sm font-medium text-slate-700">Confirmar contraseña</label>
        <input type="password" id="confirm" name="confirm" required autocomplete="new-password" minlength="8"
          class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          placeholder="Repite la contraseña" />
      </div>

      <div id="error-msg" class="hidden rounded bg-red-50 px-3 py-2 text-sm text-red-700"></div>

      <button type="submit" id="submit-btn"
        class="flex min-h-[44px] w-full items-center justify-center rounded-lg bg-brand px-4 font-semibold text-white transition hover:bg-brand-dark disabled:opacity-60">
        Guardar nueva contraseña
      </button>
    </form>
  </div>
</Shell>

<script>
  const form = document.getElementById("reset-form") as HTMLFormElement;
  const errorDiv = document.getElementById("error-msg") as HTMLDivElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const tokenEl = document.getElementById("token") as HTMLInputElement;
  const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorDiv.classList.add("hidden");

    const password = (form.elements.namedItem("password") as HTMLInputElement).value;
    const confirm = (form.elements.namedItem("confirm") as HTMLInputElement).value;

    if (password !== confirm) {
      errorDiv.textContent = "Las contraseñas no coinciden.";
      errorDiv.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Guardando…";

    try {
      const res = await fetch(`${apiBase}/api/v1/auth/reset-password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token: tokenEl.value, password }),
      });
      const data = await res.json() as { success: boolean; error?: { message: string } };
      if (data.success) {
        window.location.href = "/login?reset=ok";
      } else {
        errorDiv.textContent = data.error?.message ?? "Enlace inválido o expirado.";
        errorDiv.classList.remove("hidden");
      }
    } catch {
      errorDiv.textContent = "No se pudo contactar el servidor.";
      errorDiv.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Guardar nueva contraseña";
    }
  });
</script>
