---
/**
 * Pantalla de Análisis de Patrones — rediseñada.
 * 4 tabs internos:
 *   1. 🎯 Candidatos (próximo sorteo) — combina patrones y muestra cuáles números
 *      los cumplen TODOS hoy (candidatos para el próximo sorteo).
 *   2. 📜 Historial (pasado) — qué sorteos pasados del juego tuvieron un ganador
 *      que cumplía la combinación elegida (con cuántos días/sorteos atrás).
 *   3. 📚 Guía — explicación de los 25 patrones disponibles.
 *   4. ⭐ Guardados — favoritos del usuario para este juego.
 *
 * Deslogueado: CTA con enlaces reales a /login y /premium#planes.
 *
 * Nota de robustez: los datos de características se cargan client-side para
 * evitar esperas en SSR (calcular estados de 100 números tarda en Neon). El
 * script usa <script> procesado (no is:inline) y recibe estado inicial vía
 * atributos data-*, evitando la combinación is:inline+define:vars.
 */
import Shell from "../layouts/Shell.astro";
import PatternCard from "../components/PatternCard.astro";
import { getValidPayload } from "../lib/auth.ts";
import { apiGetSSR } from "../lib/api.ts";
import { GAME_LABELS } from "../lib/gameLabels.ts";
import type { GamePattern } from "@loto/shared-types";

const payload    = getValidPayload(Astro.cookies);
const loggedIn   = !!payload;
const token      = Astro.cookies.get("loto_token")?.value ?? null;

const GAMES = [
  { value: "pega3_9pm",   label: "Pega 3 · 9 PM" },
  { value: "pega3_3pm",   label: "Pega 3 · 3 PM" },
  { value: "pega3_11am",  label: "Pega 3 · 11 AM" },
  { value: "premia2_9pm", label: "Premia 2 · 9 PM" },
  { value: "premia2_3pm", label: "Premia 2 · 3 PM" },
  { value: "premia2_11am",label: "Premia 2 · 11 AM" },
  { value: "juga3_9pm",   label: "Jugá 3 · 9 PM" },
  { value: "juga3_3pm",   label: "Jugá 3 · 3 PM" },
  { value: "juga3_11am",  label: "Jugá 3 · 11 AM" },
  { value: "diaria_9pm",  label: "La Diaria · 9 PM" },
  { value: "diaria_3pm",  label: "La Diaria · 3 PM" },
  { value: "diaria_11am", label: "La Diaria · 11 AM" },
  { value: "super_premio",label: "Super Premio" },
];

const selectedGame = Astro.url.searchParams.get("game") ?? "pega3_9pm";
const selectedTab  = Astro.url.searchParams.get("tab")  ?? "candidatos";

let autoPatterns: GamePattern[] = [];
const patternsRes = await apiGetSSR<GamePattern[]>(
  `/api/v1/patterns?game=${selectedGame}`,
  Astro.locals,
);
if (patternsRes.success) autoPatterns = patternsRes.data;
---

<Shell title="Análisis de Patrones" active="patrones" ogTitle="Análisis — Loto Honduras"
  ogDescription="Combina patrones, revisa el historial de aciertos y obtén candidatos para el próximo sorteo.">
  {!loggedIn ? (
    <!-- Gate: usuario no autenticado -->
    <div class="mx-auto max-w-lg rounded-2xl border border-teal-200 bg-gradient-to-b from-teal-50 to-white p-8 text-center">
      <p class="mb-2 text-4xl">🔍</p>
      <h2 class="mb-2 text-xl font-bold text-teal-900">Análisis de Patrones</h2>
      <p class="mb-3 text-sm text-teal-800">
        Combina hasta 7 patrones, mira cuándo se cumplieron en el pasado y obtén
        candidatos para el próximo sorteo.
      </p>
      <ul class="mb-6 space-y-1 text-left text-sm text-slate-600">
        <li>✅ 25 indicadores analíticos de los 100 números</li>
        <li>✅ Historial de aciertos por juego (días/sorteos atrás)</li>
        <li>✅ Guarda tus números favoritos</li>
      </ul>
      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/login" class="rounded-lg bg-teal-600 px-5 py-2 text-sm font-semibold text-white hover:bg-teal-700">
          Iniciar sesión
        </a>
        <a href="/premium#planes" class="rounded-lg border border-teal-300 bg-white px-5 py-2 text-sm font-semibold text-teal-700 hover:bg-teal-50">
          Ver planes premium
        </a>
      </div>
    </div>
  ) : (
    <div id="analisis" data-selected-game={selectedGame} data-selected-tab={selectedTab} data-token={token ?? ""}>

      <!-- Selector de juego -->
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <label class="text-sm font-medium text-slate-700" for="game-select">Juego:</label>
        <select id="game-select" class="rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200">
          {GAMES.map(g => (
            <option value={g.value} selected={g.value === selectedGame}>{g.label}</option>
          ))}
        </select>
      </div>

      <!-- Patrones automáticos (públicos) -->
      <section class="mb-6">
        <h2 class="mb-1 text-lg font-bold text-slate-800">
          Patrones automáticos — {GAME_LABELS[selectedGame as keyof typeof GAME_LABELS] ?? selectedGame}
        </h2>
        <p class="mb-4 text-xs text-slate-500">
          Recalculados tras cada sorteo oficial: fríos/calientes (30, 90 y 365 días), rachas inversas y paridad.
        </p>
        {autoPatterns.length === 0 ? (
          <div class="rounded-lg border border-dashed border-slate-200 bg-white p-6 text-center text-sm text-slate-500">
            Aún no hay patrones calculados para este juego. Se generan automáticamente con los datos de cada sorteo.
          </div>
        ) : (
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {autoPatterns.map((p) => <PatternCard pattern={p} />)}
          </div>
        )}
      </section>

      <!-- Tabs internos — móvil: scroll horizontal con snap; desktop: pestañas en línea -->
      <div class="scrollbar-thin mb-5 flex gap-1 overflow-x-auto rounded-lg bg-slate-100 p-1 snap-x md:overflow-visible"
        style="-webkit-overflow-scrolling: touch; scroll-snap-type: x proximity;">
        {[
          { key: "candidatos", label: "🎯 Candidatos" },
          { key: "historial",  label: "📜 Historial" },
          { key: "guia",       label: "📚 Guía" },
          { key: "guardados",  label: "⭐ Guardados" },
        ].map(tab => (
          <button
            class:list={[
              "tab-btn snap-start flex-1 whitespace-nowrap rounded-md px-3 py-2 text-xs font-medium transition sm:text-sm",
              selectedTab === tab.key ? "bg-white shadow text-teal-700 font-semibold" : "text-slate-600 hover:bg-white/60",
            ]}
            data-tab={tab.key}
            type="button"
          >{tab.label}</button>
        ))}
      </div>

      <!-- Cargando estado inicial -->
      <div id="features-loading" class="hidden py-8 text-center text-sm text-slate-500">
        Calculando estado de los 100 números…
      </div>

      <!-- ── Tab 1: Candidatos (próximo sorteo) ──────────────────────────── -->
      <div id="tab-candidatos" class="tab-panel hidden">
        <div class="mb-4 rounded-lg border border-teal-100 bg-teal-50 p-4">
          <p class="text-sm text-teal-700">
            Selecciona hasta <strong>7 patrones</strong>. El sistema devuelve los números que
            cumplen <em>todas</em> las condiciones hoy (candidatos para el próximo sorteo),
            o los más cercanos si ninguno cumple todas.
          </p>
        </div>

        <div id="feature-catalog" class="mb-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Se rellena con JS -->
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button id="btn-filter" disabled class="rounded-lg bg-teal-600 px-5 py-2 text-sm font-semibold text-white disabled:opacity-40 hover:bg-teal-700">
            Candidatos para el próximo sorteo
          </button>
          <button id="btn-hits" disabled class="rounded-lg border border-teal-300 bg-white px-4 py-2 text-sm font-semibold text-teal-700 disabled:opacity-40 hover:bg-teal-50" type="button"
            title="Revisa los últimos sorteos de este juego y muestra cuándo el ganador cumplió TODOS los patrones seleccionados.">
            Ver historial de aciertos
          </button>
          <button id="btn-clear-filter" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50" type="button">
            Limpiar
          </button>
          <span id="filter-count" class="text-xs text-slate-500">0 patrones seleccionados</span>
        </div>

        <!-- Resultados candidatos -->
        <div id="filter-results" class="mt-6 hidden">
          <div id="filter-exact" class="hidden">
            <h3 class="mb-2 font-semibold text-teal-700">Candidatos exactos ✓</h3>
            <div id="filter-exact-numbers" class="flex flex-wrap gap-2"></div>
          </div>
          <div id="filter-partial" class="hidden">
            <h3 class="mb-2 font-semibold text-amber-600">Aproximación (mejor coincidencia)</h3>
            <p id="filter-partial-desc" class="mb-2 text-xs text-slate-500"></p>
            <div id="filter-partial-numbers" class="flex flex-wrap gap-2"></div>
          </div>
          <p id="filter-empty" class="hidden text-sm text-slate-500">No se encontraron candidatos con esta combinación.</p>
        </div>

        <!-- Historial (se muestra también desde el tab historial) -->
        <div id="hits-results" class="mt-6 hidden">
          <h3 class="mb-1 font-semibold text-teal-700">
            Aciertos en sorteos — <span id="hits-game-label" class="font-mono"></span>
          </h3>
          <p id="hits-summary" class="mb-3 text-xs text-slate-500"></p>
          <div id="hits-list" class="flex flex-col gap-2"></div>
          <p id="hits-empty" class="hidden text-sm text-slate-500">
            Ningún sorteo reciente del juego seleccionado tuvo un ganador que cumpliera todos los patrones.
          </p>
        </div>
      </div>

      <!-- ── Tab 2: Historial (pasado) ───────────────────────────────────── -->
      <div id="tab-historial" class="tab-panel hidden">
        <div class="mb-4 rounded-lg border border-sky-100 bg-sky-50 p-4 text-sm text-sky-800">
          <p>
            Elige una combinación de patrones arriba y toca <strong>"Ver historial de aciertos"</strong>.
            Aquí verás, en orden cronológico, <strong>cuántos sorteos y días atrás</strong> el ganador de cada
            sorteo cumplió <em>todos</em> los patrones de la combinación en este juego.
          </p>
        </div>
        <div id="historial-note" class="text-sm text-slate-500">
          Resultados en el panel de "Candidatos". Selecciona al menos un patrón para empezar.
        </div>
      </div>

      <!-- ── Tab 3: Guía de patrones ─────────────────────────────────────── -->
      <div id="tab-guia" class="tab-panel hidden">
        <div class="mb-4 rounded-lg border border-amber-100 bg-amber-50 p-4 text-sm text-amber-800">
          <p>
            Estos son los 25 indicadores que puedes combinar. Cada uno describe cuándo se activa
            un número según su historial (frecuencia, recencia, anatomía y aritmética).
          </p>
        </div>
        <div id="guide-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Se rellena con JS -->
        </div>
      </div>

      <!-- ── Tab 4: Guardados ────────────────────────────────────────────── -->
      <div id="tab-guardados" class="tab-panel hidden">
        <div class="mb-4 text-sm text-slate-600">
          Tus números favoritos para este juego. Toca un número en los resultados para guardarlo.
        </div>
        <div id="favorites-list" class="flex flex-wrap gap-2"></div>
        <p id="favorites-empty" class="hidden text-sm text-slate-500">
          No tienes favoritos para este juego. Guarda números desde los resultados.
        </p>
      </div>

    </div>
  )}
</Shell>

<script>
  // Script PROCESADO (Astro lo empaqueta; import.meta.env resuelve).
  const el = document.getElementById("analisis");
  if (el) {
    const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
    const currentGame   = el.dataset.selectedGame ?? "pega3_9pm";
    const initialTab    = el.dataset.selectedTab  ?? "candidatos";
    const token         = el.dataset.token ?? "";

    let catalog       = [] as { code: string; label: string; description: string }[];
    const selectedFeatures = new Set<string>();

    const loadingEl      = document.getElementById("features-loading");
    const tabBtns        = Array.from(document.querySelectorAll<HTMLElement>(".tab-btn"));
    const tabPanels      = Array.from(document.querySelectorAll(".tab-panel"));
    const featureCatalog = document.getElementById("feature-catalog");
    const btnFilter      = document.getElementById("btn-filter") as HTMLButtonElement | null;
    const btnHits        = document.getElementById("btn-hits") as HTMLButtonElement | null;
    const btnClear       = document.getElementById("btn-clear-filter");
    const filterCount    = document.getElementById("filter-count");
    const filterResults  = document.getElementById("filter-results");
    const filterExact    = document.getElementById("filter-exact");
    const filterPartial  = document.getElementById("filter-partial");
    const filterEmpty    = document.getElementById("filter-empty");
    const hitsResults    = document.getElementById("hits-results");
    const hitsList       = document.getElementById("hits-list");
    const hitsGameLabel  = document.getElementById("hits-game-label");
    const hitsSummary    = document.getElementById("hits-summary");
    const hitsEmpty      = document.getElementById("hits-empty");
    const guideList      = document.getElementById("guide-list");
    const favoritesList  = document.getElementById("favorites-list");
    const favoritesEmpty = document.getElementById("favorites-empty");

    const headers = (json = false) => {
      const h: Record<string, string> = {};
      if (json) h["Content-Type"] = "application/json";
      if (token) h["Authorization"] = `Bearer ${token}`;
      return h;
    };

    const favKey = () => `loto_favs_${currentGame}`;
    const loadFavs = () => {
      try { return JSON.parse(localStorage.getItem(favKey()) || "[]") as number[]; }
      catch { return []; }
    };
    const saveFavs = (favs: number[]) => localStorage.setItem(favKey(), JSON.stringify(favs));
    const toggleFav = (n: number) => {
      const favs = loadFavs();
      const i = favs.indexOf(n);
      if (i >= 0) favs.splice(i, 1); else favs.push(n);
      saveFavs(favs);
    };

    function fmtNum(n: number) { return String(n).padStart(2, "0"); }

    function numberBall(n: number, extra = "") {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = fmtNum(n);
      b.className = `h-10 w-10 rounded-full font-mono text-sm font-bold text-white shadow transition bg-teal-600 hover:bg-teal-700 ${extra}`;
      b.dataset.number = String(n);
      b.setAttribute("aria-label", `Número ${fmtNum(n)}`);
      return b;
    }

    function switchTab(tab: string) {
      tabBtns.forEach(b => {
        const active = b.dataset.tab === tab;
        b.classList.toggle("bg-white", active);
        b.classList.toggle("shadow", active);
        b.classList.toggle("text-teal-700", active);
        b.classList.toggle("font-semibold", active);
        b.classList.toggle("text-slate-600", !active);
      });
      tabPanels.forEach(p => p.classList.toggle("hidden", !p.id.endsWith(tab)));
      if (tab === "guardados") renderFavorites();
      document.querySelector(".tab-btn[data-tab='" + tab + "']")?.scrollIntoView({ block: "nearest" });
    }

    function updateFilterCount() {
      const n = selectedFeatures.size;
      if (filterCount) filterCount.textContent = `${n} patrón${n === 1 ? "" : "es"} seleccionad${n === 1 ? "o" : "os"}`;
      if (btnFilter) btnFilter.disabled = n === 0;
      if (btnHits) btnHits.disabled = n === 0;
    }

    function renderCatalog() {
      if (!featureCatalog) return;
      featureCatalog.innerHTML = "";
      for (const feat of catalog) {
        const active = selectedFeatures.has(feat.code);
        const card = document.createElement("button");
        card.type = "button";
        card.className = `feature-card text-left cursor-pointer rounded-lg border p-3 text-sm transition select-none ${
          active ? "border-teal-500 bg-teal-50 ring-2 ring-teal-300" : "border-slate-200 bg-white hover:border-teal-300"}`;
        card.dataset.code = feat.code;
        card.innerHTML = `
          <div class="mb-1 flex items-center gap-2">
            <span class="h-4 w-4 flex-shrink-0 rounded-full border-2 ${active ? "border-teal-500 bg-teal-500" : "border-slate-300"}"></span>
            <span class="font-semibold ${active ? "text-teal-700" : "text-slate-800"}"></span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed"></p>`;
        card.querySelector("span.font-semibold")!.textContent = feat.label;
        card.querySelector("p")!.textContent = feat.description;
        card.addEventListener("click", () => {
          if (selectedFeatures.has(feat.code)) selectedFeatures.delete(feat.code);
          else if (selectedFeatures.size < 7) selectedFeatures.add(feat.code);
          renderCatalog();
        });
        featureCatalog.appendChild(card);
      }
      updateFilterCount();
    }

    function renderGuide() {
      if (!guideList) return;
      guideList.innerHTML = "";
      for (const feat of catalog) {
        const card = document.createElement("div");
        card.className = "rounded-lg border border-slate-200 bg-white p-3 text-sm";
        card.innerHTML = `<div class="mb-1 font-semibold text-slate-800"></div><p class="text-xs text-slate-500"></p>`;
        card.querySelector("div")!.textContent = feat.label;
        card.querySelector("p")!.textContent = feat.description;
        guideList.appendChild(card);
      }
    }

    function showFilterResults(r: { exact: number[]; partial: number[]; matchCount: number; totalRequested: number; isExact: boolean }) {
      if (!filterResults) return;
      filterResults.classList.remove("hidden");
      filterExact?.classList.add("hidden");
      filterPartial?.classList.add("hidden");
      filterEmpty?.classList.add("hidden");

      if (r.isExact && r.exact.length > 0) {
        filterExact?.classList.remove("hidden");
        const c = document.getElementById("filter-exact-numbers");
        if (c) { c.innerHTML = ""; r.exact.forEach(n => c.appendChild(numberBall(n))); }
      } else if (r.partial.length > 0) {
        filterPartial?.classList.remove("hidden");
        const desc = document.getElementById("filter-partial-desc");
        if (desc) desc.textContent = `Ningún número cumple las ${r.totalRequested} condiciones. Los siguientes cumplen ${r.matchCount} de ${r.totalRequested}:`;
        const c = document.getElementById("filter-partial-numbers");
        if (c) { c.innerHTML = ""; r.partial.forEach(n => c.appendChild(numberBall(n, "bg-amber-500 hover:bg-amber-600"))); }
      } else {
        filterEmpty?.classList.remove("hidden");
      }
    }

    function showHits(d: { game: string; totalHits: number; hits: { drawDate: string; matchedNumbers: number[] }[]; requestedFeatures: unknown[] }) {
      if (!hitsResults) return;
      hitsResults.classList.remove("hidden");
      hitsList!.innerHTML = "";
      hitsEmpty?.classList.add("hidden");
      if (hitsGameLabel) hitsGameLabel.textContent = d.game;
      if (hitsSummary) hitsSummary.textContent =
        `${d.totalHits} sorteos tuvieron un ganador que cumple ${d.requestedFeatures.length} patrón${d.requestedFeatures.length === 1 ? "" : "es"}.`;

      if (d.hits.length === 0) { hitsEmpty?.classList.remove("hidden"); return; }

      // drawDate llega como "YYYY-MM-DDT10:00:00.000Z" (marcador del día civil en
      // Honduras, GMT-6). Mostramos SOLO la fecha del día civil actual: parseamos
      // la parte de fecha y la formateamos en tiempo hondureño, evitando que el
      // timezone del navegador desplace el día.
      const HN_TZ = "America/Tegucigalpa";
      const mondayOf = (iso: string) => {
        const datePart = iso.substring(0, 10); // "YYYY-MM-DD"
        return new Date(`${datePart}T12:00:00Z`); // mediodía UTC para formatear en HN sin cruzar día
      };
      const sorted = [...d.hits].sort((a, b) => mondayOf(b.drawDate).getTime() - mondayOf(a.drawDate).getTime());
      for (const h of sorted) {
        const row = document.createElement("div");
        row.className = "flex items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm flex-wrap";
        const d0 = mondayOf(h.drawDate);
        const midnightUtc = Date.UTC(d0.getUTCFullYear(), d0.getUTCMonth(), d0.getUTCDate(), 4, 0, 0); // 22:00 HN día previo ≈ día civil
        const diffDays = Math.max(0, Math.floor((Date.now() - midnightUtc) / 86400000));
        const fecha = d0.toLocaleDateString("es-HN", { timeZone: HN_TZ, day: "2-digit", month: "2-digit", year: "numeric", weekday: "short" });
        const meta = document.createElement("div");
        meta.className = "min-w-[12rem] text-xs text-slate-500";
        meta.innerHTML = `<div class="font-medium text-slate-700">${fecha}</div><div class="text-teal-700">hace ~${diffDays} días</div>`;
        row.appendChild(meta);
        for (const n of h.matchedNumbers) row.appendChild(numberBall(n, "bg-teal-600"));
        hitsList!.appendChild(row);
      }
    }

    function renderFavorites() {
      if (!favoritesList) return;
      const favs = loadFavs();
      favoritesList.innerHTML = "";
      if (favs.length === 0) { favoritesEmpty?.classList.remove("hidden"); return; }
      favoritesEmpty?.classList.add("hidden");
      for (const n of favs) {
        const wrap = document.createElement("div");
        wrap.className = "relative";
        const ball = numberBall(n, "bg-yellow-500 hover:bg-yellow-600");
        ball.setAttribute("aria-label", `Quitar ${fmtNum(n)} de favoritos`);
        ball.addEventListener("click", () => { toggleFav(n); renderFavorites(); });
        wrap.appendChild(ball);
        favoritesList.appendChild(wrap);
      }
    }

    async function loadCatalog() {
      try {
        const res = await fetch(`${API_BASE}/api/v1/features/catalog`, { headers: headers() });
        const data = await res.json();
        if (data.success) { catalog = data.data; renderCatalog(); renderGuide(); }
      } catch { /* offline */ }
    }

    async function loadNumberStates() {
      if (!loadingEl) return;
      loadingEl.classList.remove("hidden");
      try { await fetch(`${API_BASE}/api/v1/features/${currentGame}`, { headers: headers() }); }
      catch { /* offline */ }
      finally { loadingEl.classList.add("hidden"); }
    }

    async function runFilter() {
      if (selectedFeatures.size === 0) return;
      if (btnFilter) btnFilter.textContent = "Buscando…";
      try {
        const res = await fetch(`${API_BASE}/api/v1/features/${currentGame}/filter`, {
          method: "POST", headers: headers(true),
          body: JSON.stringify({ features: [...selectedFeatures] }),
        });
        const data = await res.json();
        if (!data.success) { alert(data.error?.message ?? "Error al filtrar."); return; }
        showFilterResults(data.data);
      } catch { alert("Error de conexión."); }
      finally { if (btnFilter) btnFilter.textContent = "Candidatos para el próximo sorteo"; }
    }

    async function runHits() {
      if (selectedFeatures.size === 0) return;
      if (btnHits) btnHits.textContent = "Consultando…";
      try {
        const res = await fetch(`${API_BASE}/api/v1/features/${currentGame}/hits`, {
          method: "POST", headers: headers(true),
          body: JSON.stringify({ features: [...selectedFeatures] }),
        });
        const data = await res.json();
        if (!data.success) { alert(data.error?.message ?? "Error al consultar historial."); return; }
        showHits(data.data);
        switchTab("candidatos");
      } catch { alert("Error de conexión."); }
      finally { if (btnHits) btnHits.textContent = "Ver historial de aciertos"; }
    }

    // ── eventos ──
    tabBtns.forEach(b => b.addEventListener("click", () => switchTab(b.dataset.tab ?? "candidatos")));
    btnFilter?.addEventListener("click", runFilter);
    btnHits?.addEventListener("click", runHits);
    btnClear?.addEventListener("click", () => {
      selectedFeatures.clear();
      filterResults?.classList.add("hidden");
      hitsResults?.classList.add("hidden");
      renderCatalog();
    });

    const gameSelect = document.getElementById("game-select") as HTMLSelectElement | null;
    gameSelect?.addEventListener("change", () => {
      const tab = new URLSearchParams(location.search).get("tab") || "candidatos";
      location.href = `/patrones?game=${encodeURIComponent(gameSelect.value)}&tab=${tab}`;
    });

    // ── inicio ──
    (async () => {
      await loadCatalog();
      await loadNumberStates();
      switchTab(initialTab);
    })();
  }
</script>
