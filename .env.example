# =====================================================================
# .env.example — Loto Honduras Analytics
# Copia a ".env" (NO versionado) con valores reales locales.
# NUNCA pongas secretos reales en este archivo de ejemplo.
# Reglas: ai-software-governance/08_DevOps/Secrets_Management.md
# =====================================================================

# --- Aplicación ---
APP_ENV=local                 # local | test | staging | production
APP_PORT=8787                 # puerto por defecto de wrangler dev (backend Hono)

# --- Base de datos: Desarrollo (Postgres en Docker) ---
# Estas tres las consume docker/docker-compose.yml para crear el contenedor.
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=loto_analytics_dev
# Y esta la consumen las apps (debe concordar con las tres de arriba).
DATABASE_URL=postgres://dev_user:change-me-in-real-env@localhost:5432/loto_analytics_dev

# --- Base de datos: Producción (Neon serverless) ---
# Driver @neondatabase/serverless sobre WebSockets. Usar solo en prod/staging.
NEON_DATABASE_URL=postgres://USER:CHANGE_ME@ep-xxxx.neon.tech/loto_analytics?sslmode=require

# --- Autenticación (JWT Edge) ---
JWT_SECRET=change-me-in-real-env

# --- Google OAuth 2.0 ---
# Crear en https://console.cloud.google.com > APIs > Credenciales > OAuth 2.0
# Redirect URI autorizado: http://localhost:8787/api/v1/auth/google/callback (dev)
#                           https://api.pronosticos-hn.oged-solutions.com/api/v1/auth/google/callback (prod)
#                           https://api-staging.pronosticos-hn.oged-solutions.com/api/v1/auth/google/callback (staging)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx
# Emails (csv, minúsculas) que se promueven a rol "admin" al autenticarse con
# Google. Se configura como secreto en el Worker (wrangler secret put).
GOOGLE_ADMIN_EMAILS=

# --- Brevo (emails transaccionales: reset de contraseña, bienvenida) ---
# Obtener en https://app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (suscripciones online) — usar SIEMPRE claves de TEST en local ---
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# --- Ingestión de sorteos (API + proxy WebShare) ---
# La API real de sorteos (SPA Nuxt 3 detrás de loteriasdehonduras.com).
API_BASE_URL=https://api.loteriasdehonduras.com/honduras
# Base de NUESTRO backend (al que el job de Actions envía los sorteos).
APP_API_BASE_URL=http://localhost:8787
# Token de servicio para POST /api/v1/ingest (máquina-a-máquina, NO es el JWT de usuario).
INGEST_SERVICE_TOKEN=change-me-in-real-env

# --- WebShare (lista de proxies rotativos; SOLO la usa el job de GitHub Actions) ---
# La URL de descarga lleva un token embebido => es un SECRETO. NO versionar el valor real.
# En GitHub: Settings > Secrets > Actions. En local solo si pruebas el job.
WEBSHARE_PROXY_LIST_URL=https://proxy.webshare.io/api/v2/proxy/list/download/TOKEN/-/any/username/direct/-/?plan_id=XXationXX

# --- Publicidad (AdSense u otra red publicitaria) ---
# Dejar vacío en desarrollo; agregar en Cloudflare Pages Dashboard en producción.
PUBLIC_API_BASE_URL=http://localhost:8787
PUBLIC_ADSENSE_ID=                    # ca-pub-XXXXXXXXXXXXXXXX (Publisher ID de AdSense)
PUBLIC_ADSENSE_SLOT_1=0000000001      # Slot entre "Fríos/Calientes" y "Rachas" (dashboard)
PUBLIC_ADSENSE_SLOT_2=0000000002      # Slot al final del dashboard
PUBLIC_ADSENSE_SLOT_3=0000000003      # Slot entre "Rachas" y "Par/Impar" (dashboard)
PUBLIC_ADSENSE_SLOT_BAR=0000000099   # Slot de la barra sticky flotante (sub-header global)

# --- Cloudflare (wrangler) ---
# Estos NO van en .env real: se gestionan con `wrangler secret put`.
# Se listan aquí solo para documentar qué secretos necesita cada Worker.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Observabilidad ---
LOG_LEVEL=debug               # debug | info | warn | error
